# =============================================================================
# ERP-система — переменные окружения
# Скопируйте файл в .env и заполните значения.
# Для локального запуска .env не обязателен: dev-настройки работают на SQLite.
# =============================================================================

# --- Django ------------------------------------------------------------------
SECRET_KEY=замените-на-случайную-строку-не-менее-50-символов
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- База данных -------------------------------------------------------------
# Если POSTGRES_DB не задан — используется SQLite (app/db.sqlite3)
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=смените-пароль
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Принудительно включить SQLite даже при заданных POSTGRES_*
USE_SQLITE=False

# --- Организация и учёт ------------------------------------------------------
COMPANY_NAME=ОсОО «Прогресс Групп»
CURRENCY=сом
VAT_RATE=12
SALES_TAX_RATE=2
INCOME_TAX_RATE=10

LANGUAGE_CODE=ru
TIME_ZONE=Asia/Bishkek

# --- API ---------------------------------------------------------------------
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=

# --- Docker ------------------------------------------------------------------
# Загрузить демо-данные при старте контейнера
SEED_DEMO=True
